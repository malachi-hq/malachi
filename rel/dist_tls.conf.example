%% ssl_dist options file for Malachi inter-node TLS (mutual authentication).
%%
%% Copy this file, set the real certificate paths, and point MALACHI_DIST_TLS_OPTFILE at the copy (with
%% MALACHI_DIST_TLS=true). Each node presents `node.crt` (signed by the shared `ca.crt`) and verifies its
%% peers against `ca.crt`, so encryption AND authentication, not just the distribution cookie.
%%
%% The connecting node checks the peer's certificate against the CA AND against the host it dialled (OTP passes
%% the host part of the node name as the TLS server name), so the certificate must name every host the nodes
%% reach each other by: one certificate per node, or one that names them all (or a wildcard such as
%% *.malachi-headless.<namespace>.svc.cluster.local). Use a CA of its own for distribution, not the one that signs
%% client certificates: any certificate this CA signed can join the cluster. Generate a CA and a node certificate
%% for given hosts with DIST_CERT_HOSTS=... scripts/generate-dist-certs.sh.
[
  {server, [
    {certfile, "/etc/malachi/dist/node.crt"},
    {keyfile, "/etc/malachi/dist/node.key"},
    {cacertfile, "/etc/malachi/dist/ca.crt"},
    {verify, verify_peer},
    {fail_if_no_peer_cert, true},
    {secure_renegotiate, true},
    {versions, ['tlsv1.3', 'tlsv1.2']}
  ]},
  {client, [
    {certfile, "/etc/malachi/dist/node.crt"},
    {keyfile, "/etc/malachi/dist/node.key"},
    {cacertfile, "/etc/malachi/dist/ca.crt"},
    {verify, verify_peer},
    {secure_renegotiate, true},
    {versions, ['tlsv1.3', 'tlsv1.2']}
  ]}
].
