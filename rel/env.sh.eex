#!/bin/sh
# Malachi release env hook, sourced by bin/malachi before the VM starts, for every command (start, rpc, remote, eval...).
# It settles Erlang distribution (#385), before anything listens:
#
# * A clustered node (MALACHI_CLUSTER_STRATEGY set, or more than one MALACHI_LOG_NODES) needs RELEASE_COOKIE: a random
#   secret of this deployment, never a value committed to the repository (Malachi.Cluster.DistGuard.denylist/0),
#   never the release's baked one, at least 20 bytes. It also needs TLS distribution (MALACHI_DIST_TLS=true with
#   MALACHI_DIST_TLS_OPTFILE), unless MALACHI_DIST_TLS=false accepts plaintext, which every boot then warns about.
#   The node checks the same again once it runs (Malachi.Cluster.DistGuard), in more detail.
# * A single node without RELEASE_COOKIE gets a random cookie on every start, kept in a directory of this user's own
#   (MALACHI_COOKIE_DIR, by default under /tmp, which the read-only image mounts as tmpfs), where rpc, remote and stop
#   read it. The image ships no cookie, so no two deployments share one.
# * MALACHI_DIST_INTERFACE (an IPv4 address) binds epmd and the distribution port to that interface, for a host
#   whose other interfaces are public (a pod IP, a cloud VM's private address). epmd also keeps listening on loopback.
#
# Every refusal exits 1 with one line on standard error; the cookie itself is never printed.

malachi_fail() {
  echo "malachi: refusing to run: $*" >&2
  exit 1
}

# --- the transport switch, in every mode ---------------------------------------------------------------------------
case "${MALACHI_DIST_TLS:-}" in
  "" | true | false) ;;
  *) malachi_fail "MALACHI_DIST_TLS must be true, false or unset" ;;
esac

if [ "${MALACHI_DIST_TLS:-}" = "true" ]; then
  [ -n "${MALACHI_DIST_TLS_OPTFILE:-}" ] || malachi_fail "MALACHI_DIST_TLS=true but MALACHI_DIST_TLS_OPTFILE is not set"
  [ -r "$MALACHI_DIST_TLS_OPTFILE" ] || malachi_fail "MALACHI_DIST_TLS_OPTFILE ($MALACHI_DIST_TLS_OPTFILE) is not readable"
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -proto_dist inet_tls -ssl_dist_optfile ${MALACHI_DIST_TLS_OPTFILE}"
fi

# --- the interface distribution binds to ----------------------------------------------------------------------------
# The address as an Erlang tuple ({10,0,0,5}), or nothing when it is not an IPv4 address. A function, so its
# positional parameters are its own: bin/malachi still reads its command from $1 after sourcing this file.
malachi_ipv4_tuple() {
  case "$1" in
    "" | *[!0-9.]* | *..* | .* | *.) return 1 ;;
  esac
  # shellcheck disable=SC2046
  set -- $(echo "$1" | tr '.' ' ')
  [ "$#" -eq 4 ] || return 1
  for malachi_octet in "$@"; do
    [ "${#malachi_octet}" -le 3 ] && [ "$malachi_octet" -le 255 ] || return 1
  done
  echo "{$1,$2,$3,$4}"
}

if [ -n "${MALACHI_DIST_INTERFACE:-}" ]; then
  malachi_tuple="$(malachi_ipv4_tuple "$MALACHI_DIST_INTERFACE")" ||
    malachi_fail "MALACHI_DIST_INTERFACE must be an IPv4 address"
  export ERL_EPMD_ADDRESS="$MALACHI_DIST_INTERFACE"
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface $malachi_tuple"
fi

# --- clustered or single --------------------------------------------------------------------------------------------
malachi_clustered=false
[ -n "${MALACHI_CLUSTER_STRATEGY:-}" ] && malachi_clustered=true
case "${MALACHI_LOG_NODES:-}" in
  *[!,\ ]*,*[!,\ ]*) malachi_clustered=true ;;
esac

if [ "$malachi_clustered" = "true" ]; then
  [ -n "${RELEASE_COOKIE:-}" ] ||
    malachi_fail "this node is clustered and RELEASE_COOKIE is not set: set it to a random secret of this deployment, for example openssl rand -hex 32"
  case "$RELEASE_COOKIE" in
    <%= Enum.join(Malachi.Cluster.DistGuard.denylist(), " | ") %>)
      malachi_fail "this node is clustered and RELEASE_COOKIE is a value committed to the Malachi repository: set a random secret" ;;
  esac
  [ "${#RELEASE_COOKIE}" -ge <%= Malachi.Cluster.DistGuard.min_cookie_bytes() %> ] ||
    malachi_fail "this node is clustered and RELEASE_COOKIE is shorter than <%= Malachi.Cluster.DistGuard.min_cookie_bytes() %> bytes: set a random secret"
  if [ -r "$RELEASE_ROOT/releases/COOKIE" ] && [ "$RELEASE_COOKIE" = "$(cat "$RELEASE_ROOT/releases/COOKIE")" ]; then
    malachi_fail "this node is clustered and RELEASE_COOKIE is the cookie baked into the release: set a random secret of this deployment"
  fi

  case "${MALACHI_DIST_TLS:-}" in
    true)
      grep -q fail_if_no_peer_cert "$MALACHI_DIST_TLS_OPTFILE" && [ "$(grep -c verify_peer "$MALACHI_DIST_TLS_OPTFILE")" -ge 2 ] ||
        malachi_fail "MALACHI_DIST_TLS_OPTFILE does not verify the peers both ways (verify_peer on each side, fail_if_no_peer_cert on the server)"
      ;;
    false)
      echo "malachi: warning: MALACHI_DIST_TLS=false, this clustered node runs Erlang distribution in plaintext" >&2
      ;;
    *)
      malachi_fail "this node is clustered and its Erlang distribution would run in plaintext: set MALACHI_DIST_TLS=true with MALACHI_DIST_TLS_OPTFILE, or MALACHI_DIST_TLS=false to accept plaintext"
      ;;
  esac
elif [ -z "${RELEASE_COOKIE:-}" ]; then
  # A single node's own cookie, in a directory only this user can enter: written fresh on every start, read by
  # the commands that reach the running node.
  malachi_cookie_dir="${MALACHI_COOKIE_DIR:-${TMPDIR:-/tmp}/malachi-cookie-$(id -u)}"
  malachi_cookie_file="$malachi_cookie_dir/COOKIE"

  malachi_private_dir() {
    [ -d "$1" ] && [ ! -h "$1" ] && [ "$(stat -c '%u %a' "$1")" = "$(id -u) 700" ]
  }
  malachi_private_file() {
    [ -f "$1" ] && [ ! -h "$1" ] && [ "$(stat -c '%u %a' "$1")" = "$(id -u) 600" ]
  }
  malachi_new_cookie() {
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
  }

  case "${RELEASE_COMMAND:-}" in
    start | start_iex | daemon | daemon_iex)
      if [ ! -e "$malachi_cookie_dir" ] && [ ! -h "$malachi_cookie_dir" ]; then
        mkdir -m 700 "$malachi_cookie_dir" 2>/dev/null || malachi_fail "cannot create the cookie directory $malachi_cookie_dir"
      fi
      malachi_private_dir "$malachi_cookie_dir" ||
        malachi_fail "the cookie directory $malachi_cookie_dir is not a directory of this user's own with mode 700"
      malachi_cookie="$(malachi_new_cookie)"
      [ "${#malachi_cookie}" -eq 64 ] || malachi_fail "cannot read random bytes for the cookie"
      malachi_tmp="$(umask 077 && mktemp "$malachi_cookie_dir/.cookie.XXXXXX")" ||
        malachi_fail "cannot write in the cookie directory $malachi_cookie_dir"
      (umask 077 && printf '%s' "$malachi_cookie" >"$malachi_tmp") && mv -f "$malachi_tmp" "$malachi_cookie_file" ||
        malachi_fail "cannot write the cookie in $malachi_cookie_dir"
      RELEASE_COOKIE="$malachi_cookie"
      ;;
    rpc | remote | stop | restart | pid)
      malachi_private_dir "$malachi_cookie_dir" && malachi_private_file "$malachi_cookie_file" ||
        malachi_fail "no cookie of a running node at $malachi_cookie_file (a file of this user's own with mode 600); is the node started, or is RELEASE_COOKIE missing?"
      RELEASE_COOKIE="$(cat "$malachi_cookie_file")"
      ;;
    *)
      # eval, version and the rest start no distribution a node is waiting on: the running node's cookie when
      # there is one, a fresh one otherwise, never the empty value the release script would fall back to.
      if malachi_private_dir "$malachi_cookie_dir" && malachi_private_file "$malachi_cookie_file"; then
        RELEASE_COOKIE="$(cat "$malachi_cookie_file")"
      else
        RELEASE_COOKIE="$(malachi_new_cookie)"
      fi
      ;;
  esac
  export RELEASE_COOKIE
fi
